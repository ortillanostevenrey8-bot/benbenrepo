rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /announcements/{announcementId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /knowledge/{knowledgeId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /documents/{documentId} {
      allow read: if signedIn();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'filename', 'storagePath', 'uploadedBy', 'uploadedAt',
          'sizeBytes', 'contentType', 'status', 'chunkCount'
        ])
        && request.resource.data.filename is string
        && request.resource.data.filename.size() > 0
        && request.resource.data.filename.size() <= 255
        && request.resource.data.storagePath is string
        && request.resource.data.storagePath.matches(
          '^walastik-documents/' + request.auth.uid + '/[A-Za-z0-9_-]+/[^/]+$'
        )
        && request.resource.data.uploadedBy == request.auth.uid
        && request.resource.data.sizeBytes is int
        && request.resource.data.sizeBytes > 0
        && request.resource.data.sizeBytes <= 104857600
        && request.resource.data.contentType in [
          'application/pdf', 'text/plain', 'text/markdown', 'text/csv'
        ]
        && request.resource.data.status == 'uploading'
        && request.resource.data.chunkCount == 0;
      allow update: if isAdmin()
        && resource.data.uploadedBy == request.auth.uid
        && resource.data.status == 'uploading'
        && request.resource.data.status == 'failed'
        && request.resource.data.errorMessage is string
        && request.resource.data.errorMessage.size() <= 160
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'errorMessage']);
      allow delete: if false;
    }

    match /ragChunks/{chunkId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create: if signedIn()
        && (
          (request.auth.uid == userId
            && request.resource.data.uid == request.auth.uid
            && (
              request.resource.data.role == 'user'
              || (request.resource.data.role == 'admin'
                && !exists(/databases/$(database)/documents/system/adminBootstrap))
            ))
          || (isAdmin()
            && request.resource.data.uid == userId
            && request.resource.data.role in ['admin', 'user']
            && request.resource.data.keys().hasOnly([
              'uid', 'name', 'username', 'authEmail', 'role', 'createdAt', 'lastSignInAt'
            ])
            && request.resource.data.name is string
            && request.resource.data.username is string
            && request.resource.data.authEmail is string)
        );
      allow update: if isAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['lastSignInAt', 'photoDataUrl', 'username', 'authEmail', 'name'])
            || (request.resource.data.uid == request.auth.uid
              && request.resource.data.role == 'admin'
              && !exists(/databases/$(database)/documents/system/adminBootstrap))
          ));
      allow delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /usernameIndex/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'authEmail'])
        && request.resource.data.uid is string
        && request.resource.data.authEmail is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.authEmail
          == request.resource.data.authEmail
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.username == username
        && (request.auth.uid == request.resource.data.uid || isAdmin());
      allow update: if signedIn()
        && resource.data.uid == request.resource.data.uid
        && request.resource.data.keys().hasOnly(['uid', 'authEmail'])
        && request.resource.data.authEmail is string
        && exists(/databases/$(database)/documents/users/$(request.resource.data.uid))
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.authEmail
          == request.resource.data.authEmail
        && get(/databases/$(database)/documents/users/$(request.resource.data.uid)).data.username == username
        && (request.auth.uid == resource.data.uid || isAdmin());
      allow delete: if signedIn() && (request.auth.uid == resource.data.uid || isAdmin());
    }

    match /system/adminBootstrap {
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/system/adminBootstrap)
        && request.resource.data.uid == request.auth.uid
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
      allow read, update, delete: if false;
    }
  }
}
